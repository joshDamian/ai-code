{
  // Type checking with no build: `npm run typecheck`. Only files that start with
  // `// @ts-check` are checked; the rest are allowed but not checked.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "include": ["src/**/*.mjs", "src/**/*.d.ts", "web/**/*.mjs", "pack/**/*.mjs"]
}
