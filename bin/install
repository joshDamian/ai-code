#!/bin/sh
# Installs a snapshot of this checkout as the `bench` command.
#
#   bin/install             copy a release and write the command
#   bin/install --service   also run the server at login (launchd or systemd)
#
# The release is a copy, so editing this checkout does not change what is installed;
# run it again to update. `./dev/bench` always runs the checkout itself.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
DEST="${BENCH_INSTALL_DIR:-${AI_CODE_INSTALL_DIR:-$HOME/bin}}"
RELEASE_ROOT="${BENCH_RELEASE_DIR:-${AI_CODE_RELEASE_DIR:-$HOME/.local/share/bench/releases}}"
DATA_ROOT="${BENCH_DATA_DIR:-${AI_CODE_DATA_DIR:-$HOME/.bench}}"

SERVICE=0
for arg in "$@"; do
  case "$arg" in
    --service) SERVICE=1 ;;
    *) printf '%s\n' "install: unknown option: $arg" "usage: bin/install [--service]" >&2; exit 2 ;;
  esac
done

command -v node >/dev/null || { echo "install: node is not on PATH" >&2; exit 1; }

# Before the rename the data lived in ~/.ai-code. It moves once, with the server that
# has it open stopped first, so nothing writes to it mid-move.
OLD_DATA="$HOME/.ai-code"
if [ "$DATA_ROOT" = "$HOME/.bench" ] && [ ! -e "$DATA_ROOT" ] && [ -d "$OLD_DATA" ]; then
  if [ "$(uname)" = Darwin ]; then
    for label in com.ai-code.server com.ai-code.supervisor; do launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true; done
  else
    systemctl --user stop ai-code.service 2>/dev/null || true
  fi
  sleep 2
  mv "$OLD_DATA" "$DATA_ROOT"
  printf '%s\n' "Moved $OLD_DATA to $DATA_ROOT"
fi

RELEASE="$RELEASE_ROOT/$(date +%Y%m%d%H%M%S)"
mkdir -p "$DEST" "$RELEASE" "$DATA_ROOT"
( cd "$ROOT" && tar --exclude='./.bench' --exclude='./.ai-code' --exclude='./node_modules' --exclude='./.git' -cf - . ) | ( cd "$RELEASE" && tar -xf - )
# Install scripts are skipped except node-pty's, which compiles the terminal's native
# module where no prebuilt one exists (Linux). That needs a C++ toolchain and Python.
( cd "$RELEASE" && npm install --omit=dev --ignore-scripts --no-audit --no-fund >/dev/null && { npm rebuild node-pty >/dev/null 2>&1 || echo "install: node-pty did not build; terminals will be unavailable (install build-essential and python3, then re-run)" >&2; } && node -e "
  const fs = require('fs'), p = require('path');
  const h = p.join('node_modules/node-pty/prebuilds', process.platform + '-' + process.arch, 'spawn-helper');
  try { if (!(fs.statSync(h).mode & 0o111)) fs.chmodSync(h, 0o755); } catch {}
" )

cat > "$DEST/bench" <<SCRIPT
#!/bin/sh
export BENCH_ROOT="\${BENCH_ROOT:-\${AI_CODE_ROOT:-$DATA_ROOT}}"
exec node "$RELEASE/src/cli.mjs" "\$@"
SCRIPT
chmod +x "$DEST/bench"
# The command's name before the rename.
printf '#!/bin/sh\nexec "%s/bench" "$@"\n' "$DEST" > "$DEST/ai-code"
chmod +x "$DEST/ai-code"
for wrapper in claude-expensive claude-cheap; do
  [ -f "$ROOT/bin/$wrapper" ] && cp "$ROOT/bin/$wrapper" "$DEST/$wrapper" && chmod +x "$DEST/$wrapper"
done

printf '%s\n' "Installed: $RELEASE" "Command:   $DEST/bench" "Data:      $DATA_ROOT"
if [ "$SERVICE" = 1 ]; then
  BENCH_ROOT="$DATA_ROOT" "$DEST/bench" service install
else
  printf '%s\n' "Run it with \`bench serve\`, or keep it running with \`bench service install\`."
fi

# Each install is a full copy, node_modules and all, so old ones are pruned: the newest
# few stay, to go back to by hand. A release a service definition names or a running
# process uses is never removed, even an old one - an install whose service step failed
# leaves the server on the release it was already running.
prune_releases() {
  KEEP="${BENCH_KEEP_RELEASES:-3}"
  IN_USE=" $(basename "$RELEASE") $(
    for f in "$HOME/.config/systemd/user/bench.service" "$HOME/Library/LaunchAgents/com.bench.server.plist"; do
      [ -f "$f" ] && grep -o "$RELEASE_ROOT/[0-9]*" "$f" || true
    done
    # -ww matters: without it BSD and macOS ps clip a command to the terminal width,
    # which drops the release path off the end of a long one and lets a release that is
    # genuinely in use be deleted.
    ps -eww -o args 2>/dev/null | grep -o "$RELEASE_ROOT/[0-9]*" || true
  ) "
  IN_USE="$(printf '%s' "$IN_USE" | sed "s|$RELEASE_ROOT/||g" | tr '\n' ' ')"
  PRUNED=0
  for old in $(ls -1 "$RELEASE_ROOT" | grep -E '^[0-9]{14}$' | sort -r | tail -n +"$((KEEP + 1))"); do
    case "$IN_USE" in *" $old "*) continue ;; esac
    rm -rf "$RELEASE_ROOT/$old"
    PRUNED=$((PRUNED + 1))
  done
  [ "$PRUNED" -eq 0 ] || printf '%s\n' "Removed $PRUNED old release(s); kept the newest $KEEP in $RELEASE_ROOT"
}

prune_releases

# One prune is not enough on a machine that just restarted onto this release. `bench
# service install` returns as soon as systemd reports the unit active, while the old
# server and the sessions it spawned are still being torn down; for that window their
# argv still names their own release, so the pass above keeps a generation it could have
# let go. A second pass once the machine has settled is what collects them - without it
# the count creeps up by one per install.
if [ "$SERVICE" = 1 ]; then
  # `trap '' HUP` so closing the terminal the install was run from does not take the
  # second pass with it.
  ( trap '' HUP; sleep "${BENCH_PRUNE_DELAY:-45}"; prune_releases ) >/dev/null 2>&1 &
fi
exit 0
