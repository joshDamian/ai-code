#!/bin/sh
# Installs a snapshot of this checkout as the `ai-code` command.
#
#   bin/install-ai-code             copy a release and write the command
#   bin/install-ai-code --service   also run the server at login (launchd or systemd)
#
# The release is a copy, so editing this checkout does not change what is installed;
# run it again to update. `./dev/ai-code` always runs the checkout itself.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
DEST="${AI_CODE_INSTALL_DIR:-$HOME/bin}"
RELEASE_ROOT="${AI_CODE_RELEASE_DIR:-$HOME/.local/share/ai-code/releases}"
DATA_ROOT="${AI_CODE_DATA_DIR:-$HOME/.ai-code}"

SERVICE=0
for arg in "$@"; do
  case "$arg" in
    --service) SERVICE=1 ;;
    *) printf '%s\n' "install-ai-code: unknown option: $arg" "usage: install-ai-code [--service]" >&2; exit 2 ;;
  esac
done

command -v node >/dev/null || { echo "install-ai-code: node is not on PATH" >&2; exit 1; }

RELEASE="$RELEASE_ROOT/$(date +%Y%m%d%H%M%S)"
mkdir -p "$DEST" "$RELEASE" "$DATA_ROOT"
( cd "$ROOT" && tar --exclude='./.ai-code' --exclude='./node_modules' --exclude='./.git' -cf - . ) | ( cd "$RELEASE" && tar -xf - )
( cd "$RELEASE" && npm install --omit=dev --ignore-scripts --no-audit --no-fund >/dev/null && node -e "
  const fs = require('fs'), p = require('path');
  const h = p.join('node_modules/node-pty/prebuilds', process.platform + '-' + process.arch, 'spawn-helper');
  try { if (!(fs.statSync(h).mode & 0o111)) fs.chmodSync(h, 0o755); } catch {}
" )

cat > "$DEST/ai-code" <<SCRIPT
#!/bin/sh
export AI_CODE_ROOT="\${AI_CODE_ROOT:-$DATA_ROOT}"
exec node "$RELEASE/src/cli.mjs" "\$@"
SCRIPT
chmod +x "$DEST/ai-code"
for wrapper in claude-expensive claude-cheap; do
  [ -f "$ROOT/bin/$wrapper" ] && cp "$ROOT/bin/$wrapper" "$DEST/$wrapper" && chmod +x "$DEST/$wrapper"
done

printf '%s\n' "Installed: $RELEASE" "Command:   $DEST/ai-code" "Data:      $DATA_ROOT"
if [ "$SERVICE" = 1 ]; then
  AI_CODE_ROOT="$DATA_ROOT" "$DEST/ai-code" service install
else
  printf '%s\n' "Run it with \`ai-code serve\`, or keep it running with \`ai-code service install\`."
fi
